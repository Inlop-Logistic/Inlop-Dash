## Enturne de Vehículos — formulario público (servicio Railway independiente)
##
## Copia este archivo a .env para desarrollo local, o configura esta misma
## clave en Railway para el servicio desplegado.

# URL pública (SIN barra final) del backend Inlop-Dash que recibe el POST
# real — ej. https://inlop-dash-production.up.railway.app
# Se inyecta en tiempo de ejecución en /config.js como window.ENTURNE_API_URL;
# enturne.html nunca la hardcodea.
#
# Sin esta variable, el servidor arranca igual (sirve el HTML normalmente)
# pero /config.js deja window.ENTURNE_API_URL vacío — enturne.html lo detecta
# y bloquea el envío del formulario con un mensaje de error claro, en vez de
# intentar un POST relativo que iría a este mismo servicio estático.
INLOP_DASH_API_URL=

# Site Key del widget de Cloudflare Turnstile (control de seguridad
# pendiente de la auditoría). NO es secreta — Turnstile la diseña para
# viajar al navegador; la Secret Key correspondiente vive solo en
# Inlop-Dash (TURNSTILE_SECRET_KEY, routes/enturnes.js), nunca aquí.
# Se inyecta en tiempo de ejecución en /config.js como
# window.ENTURNE_TURNSTILE_SITE_KEY; enturne.html nunca la hardcodea.
#
# Sin esta variable, el servidor arranca igual, pero el formulario bloquea
# el envío con un mensaje de error en vez de enviar un registro sin CAPTCHA.
TURNSTILE_SITE_KEY=

# Puerto del servidor — Railway lo inyecta automáticamente como PORT.
# Solo configurar para desarrollo local si el puerto 3200 está ocupado.
# PORT=3200
