# Variables de entorno requeridas para INLOP ERP
# Copiar a .env.local y completar con los valores del proyecto.

VITE_API_URL=https://your-api.up.railway.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Hotfix RC v1.0: mismo valor que INTERNAL_API_KEY en el backend (Inlop-Dash/.env).
# Requerido por erp/src/services/http.ts para acceder a /api/* (ver ese .env.example).
VITE_INTERNAL_API_KEY=
