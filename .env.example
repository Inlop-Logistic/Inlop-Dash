## INLOP Torre de Control — variables de entorno del backend (index.js)
##
## Copia este archivo a .env (no se commitea) para desarrollo local, o
## configura estas mismas claves en Railway para producción.

# ���── ControlT — API REST / Resume (tracking periódico) ────────────────────
CONTROLT_USER=
CONTROLT_PASS=
CT_PUBLIC_USER=
CT_PUBLIC_PASS=

# ─── ControlT — SOAP / GetDetailMonitoringOrder ────────────────────────────
# El módulo SOAP reutiliza las mismas credenciales que la integración REST:
# CONTROLT_USER y CONTROLT_PASS (definidas arriba). No se requieren variables
# adicionales para SOAP.
#
# Endpoint SOAP: https://app.controlt.com.co/WS/service.asmx (HTTPS validado
# durante la Fase 2 de integración). El endpoint HTTP queda solo como
# referencia histórica — no usar en producción.
#
# Fail-fast: si CONTROLT_USER o CONTROLT_PASS no están definidas cuando el
# módulo SOAP se inicializa (Fase 4 en adelante), el servidor arroja un error
# descriptivo antes de aceptar tráfico — no quedan endpoints con config
# inválida silenciosa.
#
# CONTROLT_PASS NUNCA debe aparecer en logs, audit trails ni en ningún
# registro de llamadas al SOAP. El módulo auditLogger.js la filtra activamente.
#
# Timeout de las llamadas SOAP en milisegundos.
# Rango permitido: 1 000 – 60 000. Default: 10 000 (10 segundos).
# Calibrar en Fase 7 con mediciones reales de latencia de ControlT.
# CONTROLT_SOAP_TIMEOUT_MS=10000

# ─── Supabase ──────────────────────────────────────────────
# Service role key del proyecto Supabase (gtyydandwcgoaratmnqh). Requerida
# para que este backend pueda escribir en tablas con RLS habilitado
# (ver appclienteinlop/supabase/migrations — notificaciones_cliente, Fase 3
# del INLOP Event Engine) y para la gestión de usuarios (Auth Admin API).
#
# NUNCA exponer esta clave al navegador ni commitearla en el repositorio.
# Sin esta variable, el backend cae a la anon key (ver aviso en consola al
# iniciar) y las políticas RLS de notificaciones_cliente bloquearán sus
# escrituras.
SUPABASE_SERVICE_KEY=

# ─── Push Notifications (INLOP Event Engine, Fase 4A — Sprint 4.4) ────────
# Par de claves VAPID del proyecto. Generar UNA sola vez con:
#   npx web-push generate-vapid-keys
# La clave PÚBLICA se copia también a appclienteinlop/.env.example como
# VITE_VAPID_PUBLIC_KEY (viaja al navegador por diseño). La clave PRIVADA
# NUNCA sale de este backend ni se commitea.
#
# Sin estas dos variables, enviarPush() es un no-op (ver aviso en consola al
# iniciar) — el backend sigue funcionando con normalidad y las notificaciones
# se siguen entregando por Realtime; Push simplemente queda deshabilitado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del proyecto — requerido por el estándar VAPID (RFC 8292), lo usan
# los proveedores push (FCM/Mozilla/etc.) para contactar al operador si hace falta.
VAPID_SUBJECT=mailto:soporte@inlop.com.co

# ─── Email Notifications (Notification Orchestrator — Sprint 5.1) ─────────
# API key del proyecto en Resend (https://resend.com). Sin esta variable,
# el canal Email es un no-op (ver aviso en consola al iniciar) — el backend
# sigue funcionando con normalidad y Push sigue entregándose sin cambios;
# Email simplemente queda deshabilitado hasta configurarla.
RESEND_API_KEY=
# Remitente verificado en Resend para los correos que envía este backend
# (dominio debe estar verificado en el dashboard de Resend).
INLOP_OPS_FROM="INLOP <notificaciones@inlop.com.co>"
# Bandeja de INLOP que recibe copia operativa de ciertos eventos de negocio
# (ej. nueva solicitud, servicio confirmado/completado). No existe un
# mecanismo en base de datos para esto (empresas_cliente no tiene email) —
# mismo patrón que VAPID_SUBJECT/CLIENT_PORTAL_URL: constante de operación
# vía variable de entorno. Sin esta variable, los destinatarios "ops" se
# omiten (ver services/email/recipientResolver.js) sin afectar al resto.
INLOP_OPS_EMAIL=

# ─── Authentication Hotfix v1.0.1 — recuperación de contraseña propia ─────
# URL pública del Portal Cliente (appclienteinlop) desplegado, SIN barra
# final. Se usa para construir el `redirect_to` que POST /auth/recuperar
# envía a Supabase Auth (GoTrue), de forma que el enlace del correo de
# recuperación lleve de vuelta al Portal Cliente — no al ERP ni a ningún
# otro producto que comparta este mismo proyecto Supabase.
#
# Requiere además un paso manual (una sola vez): agregar
# "<CLIENT_PORTAL_URL>/recuperar-confirmar" a la lista blanca de
# "Redirect URLs" en Supabase Dashboard → Authentication → URL Configuration
# — GoTrue rechaza cualquier redirect_to que no esté en esa lista y cae de
# vuelta al Site URL por defecto (el comportamiento previo, roto).
#
# Sin esta variable, /auth/recuperar sigue funcionando (no rompe el envío
# del correo) pero el enlace usa el Site URL del proyecto compartido — el
# bug original.
CLIENT_PORTAL_URL=https://tu-portal-cliente.up.railway.app

# ─── ERP — invitación y recuperación de contraseña (Sprint 3D-7.8D) ──────
# URL pública del ERP React desplegado, SIN barra final. Se usa para
# construir el `redirect_to` que POST /api/usuarios (invitación de un
# usuario nuevo) y POST /api/usuarios/:id/reset-password envían a Supabase
# Auth (GoTrue), de forma que el enlace del correo lleve a la página del
# ERP donde el usuario establece su contraseña — nunca se acepta un
# redirect_to enviado por el frontend.
#
# Cada despliegue de Railway (dev/prod) es un servicio separado con sus
# propias variables — configurar un valor distinto en cada uno:
#   Desarrollo: https://merry-charisma-desarrollo.up.railway.app
#   Producción: https://merry-charisma-production-b52e.up.railway.app
#
# Requiere además un paso manual (una sola vez, por entorno): agregar
# "<ERP_RESET_PASSWORD_URL>/set-password" a la lista blanca de
# "Redirect URLs" en Supabase Dashboard → Authentication → URL Configuration.
#
# Sin esta variable, la invitación/recuperación sigue enviándose (no rompe
# el correo) pero el enlace usa el Site URL del proyecto compartido.
ERP_RESET_PASSWORD_URL=https://tu-erp.up.railway.app

# ─── Seguimiento GPS externo (Fase 10B–10D) ───────────────────────────────
# URL pública, SIN barra final, del servicio seguimiento-gps/ desplegado
# (proyecto independiente — ver seguimiento-gps/README.md § Despliegue en
# Railway). Se usa para construir el enlace "📍 Ver seguimiento GPS" que
# services/reportes/enlaceGps.js agrega al correo de un reporte de Gestión
# Logística con la opción "Incluir seguimiento GPS" activa.
#
# Sin esta variable, esa opción simplemente no genera enlace ni CTA en el
# correo (log de advertencia) — el resto del envío del reporte no se ve
# afectado. No hace falta configurarla si ningún reporte usa la función.
#
# IMPORTANTE — no basta con esta variable: el dominio donde quede publicado
# seguimiento-gps/ debe agregarse TAMBIÉN a ALLOWED_ORIGINS (más abajo) para
# que el navegador no bloquee por CORS las llamadas de esa app a
# /api/seguimiento-gps/*.
SEGUIMIENTO_GPS_URL=https://tu-seguimiento-gps.up.railway.app

# ─── Endpoints internos /api/* (Torre de Control / ERP — Hotfix RC v1.0) ──
# Secreto compartido que deben enviar los clientes internos (ERP, etc.) en el
# header `X-Internal-Api-Key` para acceder a /api/ct/*, /api/data, /api/alarmas,
# /api/pendientes, /api/solicitudes*, /api/planeados, /api/programacion*.
# Generar con cualquier string aleatorio largo (ej. openssl rand -hex 32).
#
# Fail-closed: sin esta variable, esos endpoints responden 503 (no quedan
# abiertos). Copiar el mismo valor a erp/.env como VITE_INTERNAL_API_KEY.
INTERNAL_API_KEY=

# ─── Acceso legado TorreControl.html (LEGACY-01 — eliminar al dar de baja) ──
# Token de acceso para los 5 endpoints operativos que TorreControl.html
# consulta directamente (GET /api/data, /api/alarmas, /api/pendientes,
# /api/solicitudes; PATCH /api/solicitudes/:id/estado). Separado de
# INTERNAL_API_KEY para no exponer el acceso ERP completo al cliente legado.
# Bootstrap: GET /legacy/tc-init retorna este token en tiempo de ejecución
# sin exponerlo en el HTML.
# Generar con cualquier string aleatorio largo (ej. openssl rand -hex 32).
# Fail-closed: sin esta variable, los endpoints legados responden 503.
LEGACY_TC_TOKEN=

# ─── CORS — orígenes cross-origin permitidos ───────────────────────────────
# Lista separada por comas de orígenes (scheme+host+port) que pueden hacer
# peticiones cross-origin a este backend desde el navegador. Peticiones
# server-to-server y Railway health checks siempre pasan (sin header Origin).
#
# CLIENT_PORTAL_URL se incluye automáticamente — no es necesario repetirlo.
# Solo añadir aquí orígenes adicionales (staging, ERP, herramientas internas).
#
# Sin esta variable en producción, solo CLIENT_PORTAL_URL es permitido
# (si está configurada). En desarrollo local (NODE_ENV ≠ production),
# localhost:3000/5173/4173 se permiten automáticamente.
#
# Ejemplo (incluye el dominio de seguimiento-gps/, Fase 10E — sin esto el
# flujo de Seguimiento GPS externo carga el enlace pero el navegador
# bloquea la verificación de correo/OTP por CORS):
#   ALLOWED_ORIGINS=https://portal-staging.up.railway.app,https://erp.inlop.com.co,https://tu-seguimiento-gps.up.railway.app
ALLOWED_ORIGINS=

# ─── Otros ─────────────────────────────────────────────────
# Horas tras las cuales una solicitud sin actividad se considera huérfana
ORPHAN_HOURS=4

# Puerto del servidor — Railway lo inyecta automáticamente como PORT.
# Solo configurar para desarrollo local si el puerto 3000 está ocupado.
# PORT=3000
